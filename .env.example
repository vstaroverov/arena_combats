HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://game.example.com
WORLD_DB=./data/world.sqlite
TRUST_PROXY=0

# Do not commit the real secret. Payments remain disabled until configured.
YOOKASSA_ENABLED=0
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT_MODE=payment
# Sandbox only: test_no_receipt skips receipts when YOOKASSA_MODE=test.
# Set the fiscal values approved for your merchant; no tax defaults are assumed.
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=
YOOKASSA_PAYMENT_MODE=
YOOKASSA_TAX_SYSTEM_CODE=
# Only for a separately configured external fiscalization process:
YOOKASSA_EXTERNAL_RECEIPTS_CONFIRMED=0
